{
  "name": "Friendship",
  "type": "object",
  "properties": {
    "userAId": {
      "type": "string",
      "description": "Initiator profile id"
    },
    "userAAuthId": {
      "type": "string"
    },
    "userBId": {
      "type": "string",
      "description": "Recipient profile id"
    },
    "userBAuthId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active"
      ],
      "default": "pending"
    }
  },
  "required": [
    "userAId",
    "userAAuthId",
    "userBId",
    "userBAuthId"
  ],
  "rls": {
    "create": {
      "data.userAAuthId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.userAAuthId": "{{user.id}}"
        },
        {
          "data.userBAuthId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.userAAuthId": "{{user.id}}"
        },
        {
          "data.userBAuthId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userAAuthId": "{{user.id}}"
        },
        {
          "data.userBAuthId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}