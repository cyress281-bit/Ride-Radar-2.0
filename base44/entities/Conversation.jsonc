{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "connection",
        "friendship"
      ]
    },
    "connectionRequestId": {
      "type": "string"
    },
    "friendshipId": {
      "type": "string"
    },
    "participantIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participantAUserId": {
      "type": "string"
    },
    "participantBUserId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active"
    },
    "lastMessageAt": {
      "type": "string",
      "format": "date-time"
    },
    "threadExpiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "Rolling 72hr for connection type"
    }
  },
  "required": [
    "type",
    "participantIds",
    "participantAUserId",
    "participantBUserId"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.participantAUserId": "{{user.id}}"
        },
        {
          "data.participantBUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.participantAUserId": "{{user.id}}"
        },
        {
          "data.participantBUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.participantAUserId": "{{user.id}}"
        },
        {
          "data.participantBUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}