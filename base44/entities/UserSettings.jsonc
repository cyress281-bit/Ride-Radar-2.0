{
  "name": "UserSettings",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "notifyOnConnection": {
      "type": "boolean",
      "default": true
    },
    "notifyOnMessage": {
      "type": "boolean",
      "default": true
    },
    "notifyOnRSVP": {
      "type": "boolean",
      "default": true
    },
    "notifyOnAlert": {
      "type": "boolean",
      "default": true
    },
    "showLocation": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "userId"
  ],
  "rls": {
    "create": {
      "data.userId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}