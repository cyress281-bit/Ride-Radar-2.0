{
  "name": "ConnectionRequest",
  "type": "object",
  "properties": {
    "broadcastId": {
      "type": "string"
    },
    "fromUserId": {
      "type": "string",
      "description": "Requester profile id"
    },
    "fromAuthUserId": {
      "type": "string"
    },
    "toUserId": {
      "type": "string",
      "description": "Recipient profile id"
    },
    "toAuthUserId": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "description": "Optional intro message"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    }
  },
  "required": [
    "broadcastId",
    "fromUserId",
    "fromAuthUserId",
    "toUserId",
    "toAuthUserId"
  ],
  "rls": {
    "create": {
      "data.fromAuthUserId": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.fromAuthUserId": "{{user.id}}"
        },
        {
          "data.toAuthUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.fromAuthUserId": "{{user.id}}"
        },
        {
          "data.toAuthUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.fromAuthUserId": "{{user.id}}"
        },
        {
          "data.toAuthUserId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}