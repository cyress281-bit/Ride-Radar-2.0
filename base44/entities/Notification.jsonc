{
  "name": "Notification",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "Recipient profile id"
    },
    "userAuthId": {
      "type": "string",
      "description": "Recipient auth user id"
    },
    "type": {
      "type": "string",
      "enum": [
        "connection_request",
        "connection_accepted",
        "new_message",
        "rsvp",
        "event_reminder",
        "broadcast_expired",
        "thread_expired",
        "friend_request",
        "friend_accepted",
        "alert",
        "announcement"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "isRead": {
      "type": "boolean",
      "default": false
    },
    "relatedEntityId": {
      "type": "string"
    },
    "relatedEntityType": {
      "type": "string"
    }
  },
  "required": [
    "userId",
    "userAuthId",
    "type",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.userAuthId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.userAuthId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userAuthId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}