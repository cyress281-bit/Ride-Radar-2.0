{
  "name": "UserPrivateIdentity",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "description": "Auth user id"
    },
    "profileId": {
      "type": "string",
      "description": "Linked public rider profile id"
    },
    "email": {
      "type": "string",
      "description": "Private normalized auth email"
    },
    "fullName": {
      "type": "string",
      "description": "Private full name from auth provider"
    },
    "isDeleted": {
      "type": "boolean",
      "default": false
    },
    "deletedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "userId",
    "profileId"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.userId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}