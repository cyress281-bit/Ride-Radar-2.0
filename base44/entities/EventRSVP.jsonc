{
  "name": "EventRSVP",
  "type": "object",
  "properties": {
    "broadcastId": {
      "type": "string"
    },
    "userId": {
      "type": "string",
      "description": "RSVP profile id"
    },
    "userAuthId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "interested",
        "going"
      ]
    }
  },
  "required": [
    "broadcastId",
    "userId",
    "userAuthId",
    "status"
  ],
  "rls": {
    "create": {
      "data.userAuthId": "{{user.id}}"
    },
    "read": true,
    "update": {
      "$or": [
        {
          "data.userAuthId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.userAuthId": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}