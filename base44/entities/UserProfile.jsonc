{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Stable auth identity across logins"
    },
    "fullName": {
      "type": "string",
      "description": "Private legal/real name from authenticator"
    },
    "username": {
      "type": "string",
      "description": "Unique handle (auto-generated, optional)"
    },
    "displayName": {
      "type": "string"
    },
    "avatar": {
      "type": "string",
      "description": "Avatar image URL"
    },
    "bio": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "City/region text"
    },
    "rideStyle": {
      "type": "string",
      "enum": [
        "street",
        "sport",
        "cruiser",
        "adventure",
        "touring",
        "offroad",
        "track",
        "other"
      ]
    },
    "bike": {
      "type": "string",
      "description": "Free text bike description"
    },
    "isPublic": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "displayName"
  ]
}