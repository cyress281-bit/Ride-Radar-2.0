{
  "name": "Report",
  "type": "object",
  "properties": {
    "reporterProfileId": {
      "type": "string"
    },
    "targetType": {
      "type": "string",
      "enum": [
        "user",
        "broadcast",
        "conversation",
        "message"
      ]
    },
    "targetId": {
      "type": "string"
    },
    "targetProfileId": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "safety",
        "harassment",
        "spam",
        "illegal",
        "privacy",
        "other"
      ]
    },
    "details": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "reviewing",
        "closed"
      ],
      "default": "open"
    }
  },
  "required": [
    "reporterProfileId",
    "targetType",
    "targetId",
    "reason"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}