{
  "name": "UserBlock",
  "type": "object",
  "properties": {
    "blockerProfileId": {
      "type": "string"
    },
    "blockedProfileId": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "blockerProfileId",
    "blockedProfileId"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}